session.apply_to_config(config, {
	-- Auto-save interval in seconds (default: 30)
	auto_save_interval = 60,
	-- Warn when git branches changed on restore (default: true)
	git_branch_warn = true,
})
-- Do this OS stuff after everything else to allow us to override defaults.
--
-- Handle windows specific items.
if wezterm.target_triple == "x86_64-pc-windows-msvc" then
	wezterm.log_info("Detected Windows!")
	-- We use EndeavourOS in WSL so lets specify that as our domain.
	config.default_domain = "WSL:EndeavourOS"
	-- config.default_prog = { "pwsh" }
	config.font_size = 14
end

if wezterm.target_triple == "aarch64-apple-darwin" or wezterm.target_triple == "x86_64-apple-darwin" then
	-- We are on darwin! Might use non standard font sizes cause its a smaller monitor.
	config.dpi = 144.0
	config.font_size = 12.5
end

if wezterm.target_triple == "x86_64-unknown-linux-gnu" then
	-- Handle any raw linux things.
end

return config
