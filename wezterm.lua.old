local wezterm = require("wezterm") ---@type Wezterm
local config = wezterm.config_builder()
local session = wezterm.plugin.require("https://github.com/abidibo/wezterm-sessions")
local act = wezterm.action
config.initial_cols = 124
config.initial_rows = 48
-- config.font_size = 14
-- Colors and Theme
config.color_scheme = "teide_dark"
config.use_fancy_tab_bar = true
config.hide_tab_bar_if_only_one_tab = false
config.window_background_gradient = {
	orientation = "Vertical",
	colors = { "#1D2228", "#161a1e" },
	interpolation = "CatmullRom",
	blend = "Oklab",
}
config.bold_brightens_ansi_colors = "BrightAndBold"
config.font = wezterm.font_with_fallback({
	{
		family = "MonoLisa Variable",
		weight = "Medium",
		harfbuzz_features = { "calt", "liga", "ss02", "ss07", "ss09", "ss11", "ss13" },
	},
	{
		family = "CaskaydiaCove Nerd Font Mono",
		weight = "Medium",
		harfbuzz_features = { "calt", "liga", "ss02", "ss20" },
	},
})

